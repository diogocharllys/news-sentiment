# Exemplo de variáveis de ambiente.
# Copie para `.env` (não versionado) e preencha com valores locais.
#
# As variáveis abaixo são placeholders — serão definidas em detalhe
# nas próximas fases (config via pydantic-settings).

# Database
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/news_sentiment

# Redis
# REDIS_URL=redis://localhost:6379/0

# App
# APP_ENV=development
# LOG_LEVEL=INFO

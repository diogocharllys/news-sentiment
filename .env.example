# Exemplo de variáveis de ambiente.
# Copie para `.env` (não versionado) e ajuste para o seu setup local.
#
# As mesmas variáveis são lidas tanto pelo docker-compose quanto pela
# app Python (via pydantic-settings, configurado em fase futura).

# ---------------------------------------------------------------------------
# Postgres
# ---------------------------------------------------------------------------
POSTGRES_USER=news_sentiment
POSTGRES_PASSWORD=news_sentiment
POSTGRES_DB=news_sentiment
POSTGRES_PORT=5432

# URL completa para a app (usa as variáveis acima).
# psycopg v3 driver: postgresql+psycopg
DATABASE_URL=postgresql+psycopg://news_sentiment:news_sentiment@localhost:5432/news_sentiment

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Aplicação
# ---------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
